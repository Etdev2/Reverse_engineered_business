{
  "description": "Input/output contracts per station. Each station playbook restates its own; this file is the machine-checkable index. Fields marked required must be present and non-null on commit.",
  "stations": {
    "1": {"in": {"charter_path": "str"},
          "out": {"required": ["business","serves","will_not_do","capital_at_risk","jurisdiction","approval_threshold_usd","risk_tolerance","hours_per_week"]}},
    "2": {"in": {"charter": "ref:1"},
          "out": {"required": ["tam_estimate_usd","competitors","price_band_pct","channels","seasonality","go_no_go","evidence_refs"],
                  "note": "go_no_go must cite EVIDENCE_LOG.md. 'no evidence yet' is a valid and expected value — it is not a blocker, it is the current truth."}},
    "3": {"in": {"charter": "ref:1"},
          "out": {"required": ["entity_type","filings_required","insurance_required","license_analysis","refusal_boundaries"],
                  "note": "license_analysis must state explicitly whether a customs broker license is required and why."}},
    "4": {"in": {"market": "ref:2"},
          "out": {"required": ["offer","cost_per_audit_usd","contingency_pct","margin_floor_usd","walk_away_below_usd","price_ladder"]}},
    "5": {"in": {"offer": "ref:4"},
          "out": {"required": ["data_sources","va_candidates","parser_toolchain","audits_per_week_capacity","failure_modes","lead_times"]}},
    "7": {"in": {"offer": "ref:4"},
          "out": {"required": ["name","positioning_line","one_pager","email_templates","quote_template","reviewer_passed"]}},
    "8": {"in": {"assets": "ref:7", "market": "ref:2"},
          "out": {"required": ["list_source","contacts_built","sequence","sends_queued","reviewer_passed"],
                  "note": "sends_queued writes to state/outbox/. Nothing leaves the building without reviewer_passed=true."}},
    "9": {"in": {"lead": "entity:leads"},
          "out": {"required": ["score","disqualified","disqualify_reason","enrichment","call_ticket_id"],
                  "note": "Primary producer of Call Tickets. Disqualify ruthlessly — a low score with no call is a success."}},
    "10": {"in": {"lead": "entity:leads", "offer": "ref:4", "compliance": "ref:3"},
           "out": {"required": ["quote_amount_basis","contingency_pct","margin_check_passed","proposal_path","agreement_path","requires_signature"]}},
    "11": {"in": {"quote": "entity:quotes"},
           "out": {"required": ["engagement_id","documents_requested","documents_received","acknowledged_at","expected_turnaround_days"]}},
    "12": {"in": {"engagement": "entity:engagements", "capacity": "ref:5"},
           "out": {"required": ["containers_reviewed","discrepancies","amount_at_issue_usd","basis_per_finding","dispute_package_path","confidence"],
                   "note": "basis_per_finding must name the mechanism per finding: closure|hold|free_time|chassis|holiday. 'looks wrong' is not a basis."}},
    "13": {"in": {"findings": "entity:findings"},
           "out": {"required": ["filed_by","filed_at","carrier","amount_claimed_usd","carrier_response","days_to_response","amount_recovered_usd","evidence_log_row"],
                   "note": "filed_by is client|third_party — THE unresolved variable. Every outcome writes to EVIDENCE_LOG.md A4."}},
    "14": {"in": {"dispute": "entity:disputes"},
           "out": {"required": ["trigger_event","amount","sent_at","dunning_stage","paid_amount","paid_at"],
                   "note": "trigger_event must be credit_confirmed. Invoicing on findings rather than recovery is a contract breach."}},
    "15": {"in": {"ticket": "any"},
           "out": {"required": ["category","resolution","root_cause_station","reopened_entity"]}},
    "16": {"in": {"invoices": "collection", "costs": "collection"},
           "out": {"required": ["period","pnl","cash_position","pipeline","margin_by_engagement","top_three_leaks"]}},
    "17": {"in": {"engagement": "entity:engagements"},
           "out": {"required": ["reorder_trigger","next_audit_due","review_requested","referral_asked"]}},
    "18": {"in": {"reports": "ref:16", "model": "ref:4"},
           "out": {"required": ["actual_vs_model","killed","doubled","playbooks_edited","evidence_log_updates","score_today_revisions"],
                   "note": "The only station permitted to write to stations/. Must cite the entity ids that justify each edit."}}
  }
}
